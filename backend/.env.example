PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
CORS_ORIGIN=http://localhost:5173

# Authentication Tokens
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=10d

# Cloud Media Storage (Cloudinary - Phase 1-2)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 Storage (Phase 3+)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=videotube-media-bucket

# Redis / ElastiCache (Phase 8+)
REDIS_HOST=localhost
REDIS_PORT=6379
