apiVersion: v1
kind: Secret
metadata:
  name: videotube-secrets
  namespace: videotube
type: Opaque
stringData:
  MONGODB_URI: "mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/videotube?retryWrites=true&w=majority"
  ACCESS_TOKEN_SECRET: "your_jwt_access_secret_here"
  REFRESH_TOKEN_SECRET: "videotube_dev_refresh_token_secret_1234567890"
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
  AWS_BUCKET_NAME: ""
  CLOUDINARY_CLOUD_NAME: ""
  CLOUDINARY_API_KEY: ""
  CLOUDINARY_API_SECRET: ""
